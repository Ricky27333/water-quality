      ],
      "body": {
        "type": "json",
        "raw": "{\n  \"temperature\": 28.5,\n  \"ph\": 7.85,\n  \"tds\": 350.0,\n  \"salinity\": 18.2,\n  \"do\": 6.2,\n  \"water_quality\": \"OPTIMAL\",\n  \"oxygenTurbineActive\": false,\n  \"waterTurbineActive\": false\n}"
      }
    },
    {
      "name": "GET Dashboard Sensors (Live 4 Core Readings)",
      "folderId": "f-telemetry",
      "method": "GET",
      "url": "http://127.0.0.1:8000/api/sensors",
